# Copy to .env. Never commit credentials. Local Docker defaults below.
ENVIRONMENT=development
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
DEMO_ENABLED=true
# Production: ENVIRONMENT=production, HTTPS APP_ORIGIN, COOKIE_SECURE=true, DEMO_ENABLED=false
POSTGRES_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Scheduler: timezone is a provisional assumption; report month is the preceding month.
REPORT_TIMEZONE=Europe/Zurich
REPORT_HOUR=8
REPORT_START_MONTH=2026-09
SYNC_INTERVAL_MINUTES=60
REPORT_RECIPIENTS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Choose a currently available model that supports response_format json_schema.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Read-only Google OAuth. Scopes: analytics.readonly, adwords, yt-analytics.readonly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GA4_PROPERTY_ID=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25
GOOGLE_ADS_CURRENCY=CHF
YOUTUBE_CHANNEL_ID=
# LinkedIn: Community Management approval and rw_organization_admin for company statistics.
# The personal login authorizes the app; ONLY the numeric company-page ID is queried.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ADS_ACCESS_TOKEN=
LINKEDIN_ADS_REFRESH_TOKEN=
LINKEDIN_ADS_CLIENT_ID=
LINKEDIN_ADS_CLIENT_SECRET=
LINKEDIN_AD_ACCOUNT_ID=
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_API_VERSION=202608
LINKEDIN_CURRENCY=CHF
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER=
# Microsoft Graph application access restricted to the event-list site/drive.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_DRIVE_ID=
MS_FOLDER_ID=
EVENT_DATE_COLUMN=Anmeldedatum
EVENT_EMAIL_COLUMN=E-Mail
